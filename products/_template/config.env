# Per-product context loaded by load_product_context() in .claude/hooks/jira.sh
# Copy to products/{product-id}/config.env and fill in all values.
# Do NOT commit secrets here. Use environment variables or a secrets manager.

PRODUCT_ID="{product-id}"
PRODUCT_NAME="{Product Name}"
JIRA_PROJECT="{JIRA_PREFIX}"

# Short stack description for agent context headers
PRODUCT_STACK="{e.g. React 18 + TypeScript + Next.js, Node.js API, React Native + Expo}"

# Space-separated list of key source files for agent awareness
PRODUCT_CORE_FILES="{e.g. src/app/layout.tsx src/app/page.tsx}"

# Maximum in-flight stories enforced by Delivery Coordinator Agent
PRODUCT_WIP_LIMIT=6

# Primary contact for agent escalation output
PRODUCT_TEAM_EMAIL="{owner@example.com}"
