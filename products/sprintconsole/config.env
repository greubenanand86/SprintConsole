# SprintConsole — product context loaded by jira.sh at agent startup
# Add a new product by creating products/<id>/config.env and registering it in products/registry.json

PRODUCT_ID="sprintconsole"
PRODUCT_NAME="SprintConsole"
PRODUCT_DESCRIPTION="React 18 sprint management tool for development teams"

# Jira project key for this product
JIRA_PROJECT="SC"

# Current stack — shown at top of every agent prompt
PRODUCT_STACK="React 18, Babel standalone JSX, CSS design tokens (prototype phase — TypeScript migration pending)"

# Core source files agents read/reference
PRODUCT_CORE_FILES="sprintops-app.jsx, sprintops-shared.jsx, sprintops-layout.jsx,
  sprintops-readiness.jsx, sprintops-estimation.jsx, sprintops-release.jsx,
  sprintops-config.jsx, sprintops-data.js, colors_and_type.css"

# Sprint governance thresholds
PRODUCT_WIP_LIMIT=6
PRODUCT_SPRINT_FEATURE_PCT_MIN=50
PRODUCT_SPRINT_FEATURE_PCT_MAX=60
PRODUCT_SPRINT_DEBT_PCT_MIN=15
PRODUCT_SPRINT_DEBT_PCT_MAX=20
PRODUCT_SPRINT_BUG_PCT_MIN=15
PRODUCT_SPRINT_BUG_PCT_MAX=20

# Team contact (used in escalation comments)
PRODUCT_TEAM_EMAIL="greubenanand@gmail.com"
