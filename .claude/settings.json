{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"/.claude/hooks/pm-agent.sh",
            "async": true,
            "asyncRewake": true,
            "timeout": 180,
            "statusMessage": "PM Agent — gap analysis & story creation...",
            "rewakeSummary": "PM Agent: stories created in Jira"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"/.claude/hooks/architect-agent.sh",
            "async": true,
            "asyncRewake": true,
            "timeout": 180,
            "statusMessage": "Architect + QA — refining backlog stories...",
            "rewakeSummary": "Architect Agent: stories refined"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"/.claude/hooks/ux-agent.sh",
            "async": true,
            "asyncRewake": false,
            "timeout": 120,
            "statusMessage": "UX Agent — adding flow specs to in-progress stories..."
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"/.claude/hooks/ui-agent.sh",
            "async": true,
            "asyncRewake": false,
            "timeout": 120,
            "statusMessage": "UI Agent — adding visual specs to in-progress stories..."
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"/.claude/hooks/qa-agent.sh",
            "async": true,
            "asyncRewake": true,
            "timeout": 240,
            "statusMessage": "QA Lead — creating test cases & running checks...",
            "rewakeSummary": "QA Lead: stories failed — back to dev"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"/.claude/hooks/deploy-agent.sh",
            "async": true,
            "asyncRewake": true,
            "timeout": 120,
            "statusMessage": "Deploy Specialist — checking readiness & tagging releases...",
            "rewakeSummary": "Deploy Agent: deployment issue found"
          }
        ]
      }
    ]
  }
}
