    { "tagKey": "#debt", "color": "rgba(255, 193, 7, 0.5)" },
    { "tagKey": "#spike", "color": "rgba(0, 123, 255, 0.5)" },
    { "tagKey": "#blocked", "color": "rgba(108, 117, 125, 0.5)" }
